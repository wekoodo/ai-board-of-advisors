# User profile — generated during onboarding, excluded from Git by default.
# Keep the routers and blank entity template tracked; ignore all real profile data.
# Optional layers: trust.md (or trust/ after a split) and entities/<slug>/ are local-only.
_config/profile/*
!_config/profile/CONTEXT.md
!_config/profile/entities/
_config/profile/entities/*
!_config/profile/entities/CONTEXT.md
!_config/profile/entities/_template/
!_config/profile/entities/_template/**

# Local update-check bookkeeping — last product-update check date; local-only, not profile data
_config/profile/.update-check

# User meetings — local-only (the shipped example-* meetings are NOT excluded)
meetings/*/
!meetings/example-emergency-fund/
!meetings/example-rental-property/

# Compact private meeting-history routing metadata
/meetings/index.md

# Pre-meeting document intake — folder + README tracked, dropped docs local-only
_inbox/*
!_inbox/README.md

# OS and editor files
.DS_Store
Thumbs.db
*.swp

# AI agent harness tooling — installed skill *content* is regenerable, like node_modules.
# skills-lock.json is the manifest that reproduces it on clone
# (`npx skills experimental_install`), so it IS tracked.
.agents/*
!.agents/skills/
.agents/skills/*
.claude/
.codex/

# Python bytecode (e.g. from running the icm audit script)
__pycache__/
*.pyc

# Build / iteration scratch — authoring-only, not part of the distributable
tmp/
run-iterations.ps1
